{
  "openapi": "3.1.0",
  "info": {
    "title": "PrompTugal.news Cyber",
    "version": "__VERSION__",
    "description": "Weekly totals from public vulnerability sources, for products and vendors relevant to Portugal. Aggregates only; weak signals, not an audit. Static JSON, read by GET.",
    "license": { "name": "CC BY 4.0 (our totals; each source keeps its own licence, linked in each file)", "url": "https://creativecommons.org/licenses/by/4.0/" }
  },
  "servers": [{ "url": "https://cyber.promptugal.news" }],
  "paths": {
    "/api/v1/pulse/index.json": { "get": { "summary": "The pulse: state, limits and weekly series", "responses": { "200": { "description": "The pulse", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Pulse" } } } } } } },
    "/api/v1/sources/index.json": { "get": { "summary": "The sources, their licences, and those not read", "responses": { "200": { "description": "The sources", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Sources" } } } } } } },
    "/version.json": { "get": { "summary": "The version of this build", "responses": { "200": { "description": "Version, commit and build time" } } } }
  },
  "components": {
    "schemas": {
      "License": { "type": "object", "required": ["name", "url"], "properties": { "name": { "type": "string" }, "url": { "type": "string", "format": "uri" }, "holder": { "type": "string" }, "note": { "type": "string" } } },
      "Pulse": { "type": "object", "required": ["license", "state", "limits", "series"], "properties": {
        "license": { "$ref": "#/components/schemas/License" },
        "state": { "type": "string", "enum": ["awaiting data", "live"] },
        "state_note": { "type": "string" },
        "updated": { "type": "string", "format": "date" },
        "limits": { "type": "array", "items": { "type": "string" } },
        "series": { "type": "array", "items": { "type": "object", "required": ["id", "source", "license", "points"], "properties": {
          "id": { "type": "string" }, "source": { "type": "string" }, "license": { "$ref": "#/components/schemas/License" },
          "points": { "type": "array", "items": { "type": "object", "required": ["week", "read_at"], "properties": {
            "week": { "type": "string", "description": "ISO week, e.g. 2026-W47" },
            "total": { "type": ["integer", "null"], "minimum": 5, "description": "null with fewer_than_5 true when the total is under 5" },
            "fewer_than_5": { "type": "boolean" },
            "read_at": { "type": "string", "format": "date-time" } } } } } } } } },
      "Sources": { "type": "object", "required": ["license", "sources", "not_read"], "properties": {
        "license": { "$ref": "#/components/schemas/License" },
        "sources": { "type": "array", "items": { "type": "object", "required": ["id", "name", "url", "license", "state"], "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "url": { "type": "string", "format": "uri" }, "license": { "$ref": "#/components/schemas/License" }, "state": { "type": "string" } } } },
        "not_read": { "type": "array", "items": { "type": "object", "properties": { "name": { "type": "string" }, "url": { "type": "string" }, "why": { "type": "string" } } } } } }
    }
  }
}
